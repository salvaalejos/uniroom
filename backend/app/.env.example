# ==========================================================
# CONFIGURACIÓN DE BASE DE DATOS (SUPABASE O LOCAL)
# ==========================================================
# Opción A: Supabase (Recomendado para Producción / Pruebas en la Nube)
# En Supabase -> Project Settings -> Database -> Connection string -> URI:
# 1. DATABASE_URL usa el modo "Transaction Pooler" (puerto 6543) agregando ?pgbouncer=true
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# 2. DIRECT_URL usa el modo "Session Pooler" o conexión directa (puerto 5432) para migraciones de Prisma
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Opción B: PostgreSQL Local con Docker (Puerto 5435)
DATABASE_URL="postgresql://uniroom_user:12345@127.0.0.1:5435/uniroom?schema=public&connect_timeout=30&sslmode=disable"
DIRECT_URL="postgresql://uniroom_user:12345@127.0.0.1:5435/uniroom?schema=public&connect_timeout=30&sslmode=disable"

# ==========================================================
# SEGURIDAD Y AUTENTICACIÓN (JWT)
# ==========================================================
JWT_SECRET="cambia_este_secreto_por_uno_aleatorio_y_seguro_de_al_menos_32_caracteres"

# ==========================================================
# CORREO OFICIAL (RESEND)
# ==========================================================
RESEND_API_KEY="re_tu_api_key_de_resend"
EMAIL_FROM="UniRoomie <uniroomie@uniroomie.tech>"

# ==========================================================
# SERVIDOR
# ==========================================================
PORT=3000
WS_PORT=3001
